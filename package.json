{
    "name": "@creptapay/checkout",
    "version": "0.1.1",
    "description": "Accept stablecoin payments with CreptaPay: start a payment, then redirect to the hosted checkout or embed it in an iframe.",
    "license": "MIT",
    "author": "CreptaPay",
    "homepage": "https://github.com/CreptapayHq/creptapay-checkout#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/CreptapayHq/creptapay-checkout.git"
    },
    "keywords": [
        "creptapay",
        "crypto",
        "stablecoin",
        "usdc",
        "payments",
        "checkout"
    ],
    "type": "module",
    "main": "./dist/cjs/index.cjs",
    "module": "./dist/esm/index.js",
    "types": "./dist/types/index.d.ts",
    "unpkg": "./dist/creptapay.js",
    "jsdelivr": "./dist/creptapay.js",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/esm/index.js",
            "require": "./dist/cjs/index.cjs"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "node scripts/build.mjs",
        "test": "node scripts/test.mjs",
        "prepublishOnly": "npm run build && npm run test"
    },
    "devDependencies": {
        "typescript": "^5.9.3"
    },
    "publishConfig": {
        "access": "public"
    },
    "bugs": {
        "url": "https://github.com/CreptapayHq/creptapay-checkout/issues"
    },
    "engines": {
        "node": ">=18"
    }
}
